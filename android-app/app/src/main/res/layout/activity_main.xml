<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="壁纸延展"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btnPickImage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="📷 选择"
                android:textSize="14sp"
                android:textColor="@color/accent_primary"
                android:background="@drawable/input_field_bg"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvImageInfo"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:text="选择一张图片吧～"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:paddingHorizontal="10dp"
            android:background="@drawable/input_field_bg" />

        <!-- Compact preview: the page scrolls on short screens while the preview keeps its motion. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/preview_frame"
            android:elevation="2dp"
            android:gravity="center">

            <com.example.extendwallpaper.PreviewView
                android:id="@+id/previewView"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_margin="3dp" />
        </FrameLayout>

        <!-- Bottom controls card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/surface"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分辨率"
                        android:textSize="14sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginEnd="12dp" />

                    <EditText
                        android:id="@+id/etPhoneWidth"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:inputType="number"
                        android:text="1216"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#C4BFD0"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:background="@drawable/input_field_bg" />

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="×"
                        android:textSize="16sp"
                        android:textColor="@color/text_muted" />

                    <EditText
                        android:id="@+id/etPhoneHeight"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:inputType="number"
                        android:text="2640"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#C4BFD0"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:background="@drawable/input_field_bg" />
                </LinearLayout>

                <!-- Position selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="延展位置"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginEnd="12dp" />

                    <RadioGroup
                        android:id="@+id/rgPosition"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbTop"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="上方"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbCenter"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="居中"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />

                        <RadioButton
                            android:id="@+id/rbBottom"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="下方"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Foreground protection mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="人物保护"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginEnd="8dp" />

                    <RadioGroup
                        android:id="@+id/rgProtection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbProtectionAuto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/accent_primary"
                            android:text="自动"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbProtectionReal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/accent_primary"
                            android:text="真人"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbProtectionAnime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/accent_primary"
                            android:text="二次元"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbProtectionOff"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/accent_primary"
                            android:text="关闭"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ProgressBar
                        android:id="@+id/pbProtection"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/accent_primary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvProtectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="选择图片后识别人物"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbSameColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上下同色"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:visibility="gone" />

                <!-- One selector keeps automatic sampling and manual top/bottom colours together. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="填充色"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginEnd="8dp" />

                    <View
                        android:id="@+id/vColorSwatch"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/color_swatch" />

                    <TextView
                        android:id="@+id/tvColorMode"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:text="自动取色"
                        android:textSize="12sp"
                        android:textColor="@color/accent_primary"
                        android:background="@drawable/input_field_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="打开填充颜色选择" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="渐变区域"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvModifyZone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10%"
                        android:textSize="14sp"
                        android:textColor="@color/accent_primary"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbModifyZone"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:max="100"
                    android:progress="10"
                    android:thumbTint="@color/accent_primary"
                    android:progressTint="@color/accent_primary"
                    android:progressBackgroundTint="#E8E4F0"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/btnGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:background="@drawable/btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="4dp">

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone"
                        android:indeterminateTint="@color/text_on_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="生成壁纸 ✨"
                        android:textSize="16sp"
                        android:textColor="@color/text_on_primary"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
